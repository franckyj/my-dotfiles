@import "colors.rasi"

* {
    font: "JetBrainsMono Nerd Font 12";  /* Monospace font for alignment */
}

configuration {
    show-icons: true;
    icon-theme: "rose-pine-moon";
    location: 0;
    display-drun: "Launch:";
}

#window {
    width: 20%;
    transparency: "real";
    orientation: vertical;
    border-radius: 10px;
}

#mainbox {
    children: [inputbar, listview];
}

// ELEMENT
// -----------------------------------

#element {
    padding: 4 8;
    border-radius: 5px;
}

#element-icon {
    size: 16 px;
    padding: 0 6 0 0;
    alignment: vertical;
}

#listview {
    columns: 1;  /* Show in a single column for better alignment */
    lines: 8;
    padding: 8 0;
    fixed-height: true;
    fixed-columns: true;
    fixed-lines: true;
    border: 0 10 6 10;
}

#inputbar {
    padding: 10 0 0;
    margin: 0 0 0 0;
}

#entry {
    padding: 10 10 0 0;
    margin: 0 -2 0 0;
}

#prompt {
    padding: 10 6 0 10;
    margin: 0 -2 0 0;
}
