/* Monokai — rofi color variables. */

* {
    bg:          #272822;
    fg:          #f8f8f2;
    accent:      #f92672;
    accent-2:    #fd971f;
    border:      #f92672;
    urgent:      #fd971f;
    selected-fg: #f8f8f2;
    entry-fg:    #fd971f;
    prompt-fg:   #f92672;
    header:      #66d9ef;

    background-color: @bg;
}
